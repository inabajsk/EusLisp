;;; MODE=interp|comp  BDIR=dir  eus bench-run.l   (best of 3, wall clock seconds)
(if (equal (unix:getenv "MODE") "comp")
    (load (format nil "~A/bench-defs.so" (unix:getenv "BDIR")))
  (load (format nil "~A/bench-defs.l" (unix:getenv "BDIR"))))
(defun now () (let ((tv (unix:gettimeofday))) (+ (car tv) (* 1e-6 (cadr tv)))))
(dolist (b *benches*)
  (let ((best 1e9) r t0)
    (dotimes (k 3)
      (setq t0 (now))
      (setq r (apply (car b) (cdr b)))
      (setq best (min best (- (now) t0))))
    (format t "BENCH ~A ~A ~A~%" (car b) (unix:getenv "MODE") best)))
(exit 0)
